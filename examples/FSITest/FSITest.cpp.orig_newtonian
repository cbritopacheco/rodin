  static void setPETScDefault(const char* key, const char* value)
  {
    PetscBool set = PETSC_FALSE;
    PetscOptionsHasName(PETSC_NULLPTR, PETSC_NULLPTR, key, &set);
    if (!set)
      PetscOptionsSetValue(PETSC_NULLPTR, key, value);
  }

  static void getReal(const char* name, Real& v)
  {
    PetscReal x = v;
    PetscBool set = PETSC_FALSE;
    PetscOptionsGetReal(PETSC_NULLPTR, PETSC_NULLPTR, name, &x, &set);
    if (set)
      v = x;
  }

  static void getSize(const char* name, size_t& v)
  {
    PetscInt x = static_cast<PetscInt>(v);
    PetscBool set = PETSC_FALSE;
    PetscOptionsGetInt(PETSC_NULLPTR, PETSC_NULLPTR, name, &x, &set);
    if (set)
      v = static_cast<size_t>(std::max<PetscInt>(0, x));
  }

  static Config readOptions()
  {
    Config c;
    getSize("-fsitest_levels", c.levels);
    getSize("-fsitest_n0", c.n0);
    getReal("-fsitest_dt0", c.dt0);
    getReal("-fsitest_T", c.T);
    getReal("-fsitest_H", c.H);
    getReal("-fsitest_gamma", c.robinGamma);
    getReal("-fsitest_alpha", c.robinAlpha);
    getSize("-fsitest_coupling_iterations", c.couplingIterations);
    getReal("-fsitest_coupling_tol", c.couplingTolerance);
    getReal("-fsitest_A", c.mms.A);
    getReal("-fsitest_B", c.mms.B);
    getReal("-fsitest_P0", c.mms.P0);
    getReal("-fsitest_rho_f", c.mms.rhoF);
    getReal("-fsitest_mu_f", c.mms.muF);
    getReal("-fsitest_rho_s", c.mms.rhoS);
    getReal("-fsitest_lambda_s", c.mms.lamS);
    getReal("-fsitest_mu_s", c.mms.muS);
    PetscBool xdmf = PETSC_FALSE, set = PETSC_FALSE;
    PetscOptionsGetBool(PETSC_NULLPTR, PETSC_NULLPTR, "-fsitest_xdmf", &xdmf, &set);
    if (set)
      c.xdmf = (xdmf == PETSC_TRUE);
    getReal("-fsitest_vms_scale", c.vmsScale);
    getReal("-fsitest_graddiv_scale", c.gradDivScale);
    getReal("-fsitest_pgp_scale", c.pgpScale);
    getReal("-fsitest_pspg_residual", c.pspgResidualScale);
    PetscBool heart = PETSC_FALSE;
    set = PETSC_FALSE;
    PetscOptionsGetBool(PETSC_NULLPTR, PETSC_NULLPTR, "-fsitest_heart_lambda", &heart, &set);
    if (set && heart == PETSC_TRUE)
      c.lambdaMode = Config::LambdaMode::Pointwise;
    char mode[64] = {};
    set = PETSC_FALSE;
    PetscOptionsGetString(PETSC_NULLPTR, PETSC_NULLPTR, "-fsitest_lambda", mode, sizeof(mode), &set);
    if (set)
    {
      const std::string sm(mode);
      if (sm == "update")
        c.lambdaMode = Config::LambdaMode::Update;
      else if (sm == "residual")
        c.lambdaMode = Config::LambdaMode::Residual;
      else if (sm == "pointwise")
        c.lambdaMode = Config::LambdaMode::Pointwise;
      else
        throw std::runtime_error("-fsitest_lambda must be update|residual|pointwise");
    }
    c.couplingIterations = std::max<size_t>(1, c.couplingIterations);
    return c;
  }

  static void computeConnectivity(MeshType& mesh)
  {
    const size_t D = mesh.getDimension();
    mesh.getConnectivity().compute(D, D);
    mesh.getConnectivity().compute(D, 0);
    mesh.getConnectivity().compute(D, D - 1);
    mesh.getConnectivity().compute(D - 1, D);
    mesh.getConnectivity().compute(D - 1, 0);
    mesh.getConnectivity().compute(1, 0);
  }

  static Math::SpatialPoint faceCentroid(const MeshType& mesh, const Polytope& face)
  {
    Math::SpatialPoint c(mesh.getSpaceDimension());
    c.setZero();
    for (const auto& v : face.getVertices())
      c += mesh.getVertexCoordinates(v);
    c /= static_cast<Real>(face.getVertices().size());
    return c;
  }

  /// Unit-square fluid mesh (nx = ny = n cells), boundary faces tagged by position.
  static MeshType makeFluidMesh(size_t n)
  {
    MeshType mesh;
    mesh = mesh.UniformGrid(Polytope::Type::Triangle, { n + 1, n + 1 });
    mesh.scale(1.0 / static_cast<Real>(n));
    computeConnectivity(mesh);

    const Real eps = 1.0e-10;
    std::vector<std::pair<Index, Attribute>> tags;
    for (auto it = mesh.getBoundary(); it; ++it)
    {
      const auto c = faceCentroid(mesh, *it);
      Attribute a = BoundaryFluid::Bottom;
      if (c(1) < eps)
        a = BoundaryFluid::Bottom;
      else if (c(1) > 1.0 - eps)
        a = BoundaryFluid::FSI;
      else if (c(0) < eps)
        a = BoundaryFluid::Left;
      else
        a = BoundaryFluid::Right;
      tags.emplace_back(it->getIndex(), a);
    }
    for (const auto& [f, a] : tags)
      mesh.setAttribute({ 1, f }, a);
    return mesh;
  }

  /// Solid strip (0,1) x (1, 1+H), same x-spacing as the fluid (conforming).
  static MeshType makeSolidMesh(size_t n, Real H)
  {
    const size_t ny = std::max<size_t>(1, static_cast<size_t>(std::lround(H * n)));
    MeshType mesh;
    mesh = mesh.UniformGrid(Polytope::Type::Triangle, { n + 1, ny + 1 });
    mesh.scale(1.0 / static_cast<Real>(n));
    // Stretch y to exactly H (if H*n is not an integer) and lift to y = 1.
    const Real sy = H / (static_cast<Real>(ny) / static_cast<Real>(n));
    for (auto it = mesh.getVertex(); it; ++it)
    {
      Math::SpatialPoint x = mesh.getVertexCoordinates(it->getIndex());
      x(1) = 1.0 + sy * x(1);
      mesh.setVertexCoordinates(it->getIndex(), x);
    }
    mesh.flush();
    computeConnectivity(mesh);

    const Real eps = 1.0e-10;
    std::vector<std::pair<Index, Attribute>> tags;
    for (auto it = mesh.getBoundary(); it; ++it)
    {
      const auto c = faceCentroid(mesh, *it);
      Attribute a = BoundarySolid::Sides;
      if (c(1) < 1.0 + eps)
        a = BoundarySolid::FSI;
      else if (c(1) > 1.0 + H - eps)
        a = BoundarySolid::Top;
      tags.emplace_back(it->getIndex(), a);
    }
    for (const auto& [f, a] : tags)
      mesh.setAttribute({ 1, f }, a);
    return mesh;
  }

  template <class MeshT>
  static void saveReferenceVertices(const MeshT& mesh, std::vector<Math::SpatialPoint>& x)
  {
    x.resize(mesh.getVertexCount());
    for (auto it = mesh.getVertex(); it; ++it)
      x[it->getIndex()] = mesh.getVertexCoordinates(it->getIndex());
  }

  template <class MeshT>
  static void restoreMeshToReference(MeshT& mesh, const std::vector<Math::SpatialPoint>& x)
  {
    for (auto it = mesh.getVertex(); it; ++it)
      mesh.setVertexCoordinates(it->getIndex(), x[it->getIndex()]);
    mesh.flush();
  }

  template <class MeshT, class FES, class GF>
  static void moveMeshWithVertexDisplacement(MeshT& mesh,
    const std::vector<Math::SpatialPoint>& x0, const FES& fes, const GF& disp)
  {
    const size_t dim = mesh.getSpaceDimension();
    for (auto it = mesh.getVertex(); it; ++it)
    {
      const Index vtx = it->getIndex();
      auto x = x0[vtx];
      for (Index c = 0; c < static_cast<Index>(dim); ++c)
        x(c) += disp[fes.getGlobalIndex({ 0, vtx }, c)];
      mesh.setVertexCoordinates(vtx, x);
    }
    mesh.flush();
  }

  // ------------------------------------------------------------------------
  // Interface vertex map (the meshes are conforming vertex by vertex on the
  // reference interface).
  // ------------------------------------------------------------------------
  struct InterfaceVertex
  {
      Index fluid;
      Index solid;
      Math::SpatialPoint X; ///< reference position
  };

  static std::vector<InterfaceVertex> buildInterfaceVertices(
    const MeshType& fluid, const MeshType& solid)
  {
    auto key = [](const Math::SpatialPoint& c) {
      return static_cast<long long>(std::llround(c(0) * 1.0e9));
    };
    std::map<long long, Index> solidByKey;
    for (auto it = solid.getBoundary(); it; ++it)
      if (it->getAttribute() == BoundarySolid::FSI)
        for (const auto vtx : it->getVertices())
          solidByKey[key(solid.getVertexCoordinates(vtx))] = vtx;

    std::map<Index, InterfaceVertex> out;
    for (auto it = fluid.getBoundary(); it; ++it)
    {
      if (it->getAttribute() != BoundaryFluid::FSI)
        continue;
      for (const auto vtx : it->getVertices())
      {
        const Math::SpatialPoint X = fluid.getVertexCoordinates(vtx);
        const auto found = solidByKey.find(key(X));
        if (found == solidByKey.end())
          throw std::runtime_error("buildInterfaceVertices: non-conforming interface.");
        out[vtx] = InterfaceVertex{ vtx, found->second, X };
      }
    }
    if (out.size() != solidByKey.size())
      throw std::runtime_error("buildInterfaceVertices: vertex count mismatch.");
    std::vector<InterfaceVertex> v;
    for (auto& [k, iv] : out)
      v.push_back(iv);
    return v;
  }

  /// Parameter s in [0,1] of a point along the segment v0 -> v1 (current coordinates).
  static Real segmentParameter(const MeshType& mesh, const Polytope& face, const Point& p)
  {
    const auto& v = face.getVertices();
    const Math::SpatialPoint a = mesh.getVertexCoordinates(v[0]);
    const Math::SpatialPoint b = mesh.getVertexCoordinates(v[1]);
    const Math::SpatialPoint e = b - a;
    return (p.getPhysicalCoordinates() - a).dot(e) / e.squaredNorm();
  }

  /// Point on a segment at parameter s along v0 -> v1, in the mesh's CURRENT
  /// configuration.  The reference coordinate is s or 1 - s depending on the
  /// transformation's orientation; it is resolved by a forward evaluation.
  static Point pointOnSegment(const MeshType& mesh, const Polytope& face, Real s)
  {
    const auto& v = face.getVertices();
    const Math::SpatialPoint a = mesh.getVertexCoordinates(v[0]);
    const Math::SpatialPoint b = mesh.getVertexCoordinates(v[1]);
    Math::SpatialPoint pc = a + s * (b - a);

    Math::SpatialPoint rc(1);
    rc(0) = s;
    Math::SpatialPoint test;
    face.getTransformation().transform(test, rc);
    if ((test - pc).norm() > 1.0e-9 * (1.0 + (b - a).norm()))
      rc(0) = 1.0 - s;
    return Point(face, rc, pc);
  }

  /// Reference interface position X of a point of the (moving) fluid FSI face.
  static Math::SpatialPoint fluidPointToReference(const MeshType& fluid,
    const std::vector<Math::SpatialPoint>& x0, const Point& p)
  {
    const Polytope& face = p.getPolytope();
    const Real s = segmentParameter(fluid, face, p);
    const auto& v = face.getVertices();
    return x0[v[0]] + s * (x0[v[1]] - x0[v[0]]);
  }

  static Vec2 vec2(const std::array<Real, 2>& a)
  {
    Vec2 v(2);
    v(0) = a[0];
    v(1) = a[1];
    return v;
  }

  // Degree-5 Dunavant rule on the unit right triangle (weights sum to 1).
  struct TriRule
  {
      std::array<std::array<Real, 2>, 7> x;
      std::array<Real, 7> w;
  };

  static const TriRule& triRule()
  {
    static const TriRule r = [] {
      TriRule q;
      const Real a1 = 0.059715871789770, b1 = 0.470142064105115;
      const Real a2 = 0.797426985353087, b2 = 0.101286507323456;
      const Real w0 = 0.225, w1 = 0.132394152788506, w2 = 0.125939180544827;
      q.x = { { { 1.0 / 3.0, 1.0 / 3.0 }, { b1, b1 }, { a1, b1 }, { b1, a1 },
        { b2, b2 }, { a2, b2 }, { b2, a2 } } };
      q.w = { w0, w1, w1, w1, w2, w2, w2 };
      return q;
    }();
    return r;
  }

  /// sqrt( int_Omega |fh - fex|^2 ) with a degree-5 rule on the current mesh.
  template <class Discrete, class Exact>
  static Real l2Error(const MeshType& mesh, const Discrete& fh, const Exact& fex)
  {
    const auto& q = triRule();
    Real sum = 0.0;
    for (auto it = mesh.getCell(); it; ++it)
    {
      const Real area = it->getMeasure();
      for (size_t k = 0; k < q.w.size(); ++k)
      {
        Math::SpatialPoint rc(2);
        rc(0) = q.x[k][0];
        rc(1) = q.x[k][1];
        const Point p(*it, rc);
        sum += q.w[k] * area * fex(p, fh);
      }
    }
    return std::sqrt(std::max<Real>(sum, 0.0));
  }

  /// 3-point Gauss-Legendre on [0,1].
  static const std::array<std::pair<Real, Real>, 3>& gauss3()
  {
    static const std::array<std::pair<Real, Real>, 3> g{ {
      { 0.5 - 0.5 * std::sqrt(0.6), 5.0 / 18.0 },
      { 0.5, 8.0 / 18.0 },
      { 0.5 + 0.5 * std::sqrt(0.6), 5.0 / 18.0 } } };
    return g;
  }

  static Real order(Real eCoarse, Real eFine)
  {
    if (!(eCoarse > 0.0) || !(eFine > 0.0))
      return std::numeric_limits<Real>::quiet_NaN();
    return std::log(eCoarse / eFine) / std::log(2.0);
  }

  // ------------------------------------------------------------------------
  // One refinement level
  // ------------------------------------------------------------------------
  static Errors runLevel(const Config& cfg, size_t level)
  {
    const size_t N = cfg.n0 << level;
    const Real dt = cfg.dt0 / static_cast<Real>(1u << level);
    const size_t nsteps = static_cast<size_t>(std::llround(cfg.T / dt));
    const MMS::MMSParams& m = cfg.mms;
    const Real rho = m.rhoF;

    Errors err;
    err.n = N;
    err.dt = dt;
    err.steps = nsteps;

    MeshType meshFluid = makeFluidMesh(N);
    MeshType meshSolid = makeSolidMesh(N, cfg.H);
    const size_t dim = 2;

    std::vector<Math::SpatialPoint> referenceVertices;
    saveReferenceVertices(meshFluid, referenceVertices);
    const std::vector<InterfaceVertex> sigma = buildInterfaceVertices(meshFluid, meshSolid);

    // Equal-order P1/P1 fluid (VMS), P1 solid.  The fluid P1 vector space also
    // carries the ALE displacement and the interface traces (V_h^g, eq. 12).
    using VectorFES = H1<1, Math::SpatialVector<Real>, MeshType>;
    using ScalarFES = H1<1, Real, MeshType>;
    using VectorGF = PETSc::Variational::GridFunction<VectorFES>;

    VectorFES uh(std::integral_constant<size_t, 1>{}, meshFluid, dim);
    ScalarFES ph(std::integral_constant<size_t, 1>{}, meshFluid);
    VectorFES dh(std::integral_constant<size_t, 1>{}, meshSolid, dim);

    PETSc::Variational::TrialFunction u(uh);
    PETSc::Variational::TrialFunction p(ph);
    PETSc::Variational::TestFunction v(uh);
    PETSc::Variational::TestFunction q(ph);
    PETSc::Variational::TrialFunction d(dh);
    PETSc::Variational::TestFunction w(dh);
    u.setName("u");
    p.setName("p");
    d.setName("d");

    // Fluid-side fields.
    VectorGF uOld(uh), uCur(uh), uDir(uh);
    PETSc::Variational::GridFunction pOld(ph), pCur(ph);
    VectorGF aleDisp(uh), aleDispOld(uh), meshVelocity(uh), liftData(uh);
    VectorGF ddotF(uh);       // ddot^{n-1/2} on Sigma (zero elsewhere)
    VectorGF lambdaF(uh);     // lambda = sigma_f n_f on the reference Sigma
    VectorGF tractionPW(uh);  // pointwise mode only
    // Solid-side fields.
    VectorGF dState(dh), dOld(dh), dMid(dh), etaState(dh), dPred(dh);
    VectorGF vOld(dh), vNew(dh), dExact(dh);
    VectorGF uS(dh);          // u^{n,k-1} on Sigma (solid numbering)
    VectorGF lambdaS(dh);     // lambda^{n,k-1} on Sigma (solid numbering)

    Real tNow = 0.0; // time at which every data function is evaluated

    auto fdof = [&](Index vtx, Index c) { return uh.getGlobalIndex({ 0, vtx }, c); };
    auto sdof = [&](Index vtx, Index c) { return dh.getGlobalIndex({ 0, vtx }, c); };

    // ---- exact fields / data -----------------------------------------------
    auto evalMMS = [&](void (*f)(Real, Real, Real, const MMS::MMSParams&, Real*),
                     const Point& pt) {
      const auto& x = pt.getPhysicalCoordinates();
      std::array<Real, 2> o{};
      f(x(0), x(1), tNow, m, o.data());
      return vec2(o);
    };
    auto evalAt = [&](void (*f)(Real, Real, Real, const MMS::MMSParams&, Real*),
                    const Math::SpatialPoint& X) {
      std::array<Real, 2> o{};
      f(X(0), X(1), tNow, m, o.data());
      return vec2(o);
    };
    const auto zero = VectorFunction(dim, [&](const Point&) {
      Vec2 z(2);
      z.setZero();
      return z;
    });
    const auto uExact = VectorFunction(dim,
      [&](const Point& pt) { return evalMMS(MMS::fluidVelocity, pt); });
    const auto fluidForce = VectorFunction(dim,
      [&](const Point& pt) { return evalMMS(MMS::fluidForce, pt); });
    const auto pExact = RealFunction([&](const Point& pt) {
      const auto& x = pt.getPhysicalCoordinates();
      Real o = 0;
      MMS::fluidPressure(x(0), x(1), tNow, m, &o);
      return o;
    });
    // Solid data at REFERENCE positions (the solid mesh never moves).
    const auto solidForce = VectorFunction(dim,
      [&](const Point& pt) { return evalMMS(MMS::solidForce, pt); });
    const auto solidTopTraction = VectorFunction(dim,
      [&](const Point& pt) { return evalMMS(MMS::solidTopTraction, pt); });
    const auto dExactFn = VectorFunction(dim,
      [&](const Point& pt) { return evalMMS(MMS::solidDisplacement, pt); });
    const auto hSolid = VectorFunction(dim,
      [&](const Point& pt) { return evalMMS(MMS::interfaceDynamicMismatch, pt); });
    const auto gUSolid = VectorFunction(dim,
      [&](const Point& pt) { return evalMMS(MMS::interfaceKinematicMismatch, pt); });
    // Kinematic mismatch at the reference position of a (moving) fluid point.
    auto gUAtFluid = [&](const Point& pf) {
      return evalAt(MMS::interfaceKinematicMismatch,
        fluidPointToReference(meshFluid, referenceVertices, pf));
    };

    // ---- constants -----------------------------------------------------------
    const Real youngEq = m.muS * (3.0 * m.lamS + 2.0 * m.muS) / (m.lamS + m.muS);
    const Real alpha = (cfg.robinAlpha > 0.0)
      ? cfg.robinAlpha
      : cfg.robinGamma * std::sqrt(m.rhoS * youngEq);
    const Real solidMass = 2.0 * m.rhoS / (dt * dt); // mid-point inertia

    const auto normalFluid = BoundaryNormal(meshFluid);

    // ---- reference interface mass matrix M_Sigma (fluid numbering) ----------
    // Assembled once, with the fluid mesh in its reference configuration: every
    // Sigma term of (17)-(18) is an integral on the reference interface.
    PETSc::Variational::TrialFunction uT(uh);
    PETSc::Variational::TestFunction vT(uh);
    PETSc::Variational::BilinearForm massSigma(uT, vT);
    massSigma = BoundaryIntegral(uT, vT).over(BoundaryFluid::FSI);
    massSigma.assemble();
    ::Mat M0 = massSigma.getOperator();

    // Old-configuration velocity mass matrix for s_Omega (15).
    PETSc::Variational::TrialFunction uT2(uh);
    PETSc::Variational::TestFunction vT2(uh);
    PETSc::Variational::BilinearForm massOldMatrix(uT2, vT2);
    massOldMatrix = Integral(uT2, vT2);

    // Dirichlet velocity DOFs (bottom, left, right; they include the two end
    // points of Sigma).
    std::vector<char> isDirichlet(uh.getSize(), 0);
    for (auto it = meshFluid.getBoundary(); it; ++it)
    {
      const auto a = it->getAttribute();
      if (a != BoundaryFluid::Bottom && a != BoundaryFluid::Left && a != BoundaryFluid::Right)
        continue;
      const size_t nloc = uh.getFiniteElement(1, it->getIndex()).getCount();
      for (size_t loc = 0; loc < nloc; ++loc)
        isDirichlet[uh.getGlobalIndex({ 1, it->getIndex() }, loc)] = 1;
    }
    std::vector<PetscInt> sigmaDofs;
    for (const auto& iv : sigma)
      for (Index c = 0; c < 2; ++c)
        sigmaDofs.push_back(static_cast<PetscInt>(fdof(iv.fluid, c)));

    // ---- initial state (exact) -------------------------------------------------
    tNow = 0.0;
    uOld = uExact;
    uCur = uExact;
    pOld = pExact;
    pCur = pExact;
    dOld = dExactFn;
    dState = dExactFn;
    dMid = dExactFn;
    etaState = zero;
    vOld = VectorFunction(dim, [&](const Point& pt) { return evalMMS(MMS::solidVelocity, pt); });
    vNew = vOld;
    aleDisp = zero;
    aleDispOld = zero;
    meshVelocity = zero;
    ddotF = zero;
    lambdaF = zero;
    for (const auto& iv : sigma)
    {
      // sigma_ex n_f with the reference normal (0, 1) of this geometry.
      std::array<Real, 4> sg{};
      MMS::fluidStress(iv.X(0), iv.X(1), 0.0, m, sg.data());
      lambdaF[fdof(iv.fluid, 0)] = sg[1];
      lambdaF[fdof(iv.fluid, 1)] = sg[3];
    }

    // ---- fluid: kinematics and VMS ------------------------------------------
    const auto transportLag = uOld - meshVelocity;
    const auto convU = Mult(Jacobian(u), transportLag);
    const auto symU = 0.5 * (Jacobian(u) + Transpose(Jacobian(u)));
    const auto symV = 0.5 * (Jacobian(v) + Transpose(Jacobian(v)));
    // Temam + s_Omega: (rho/2) div(u^{n-1} - 2w) + (rho/2) div w.
    const auto divCoefficient = 0.5 * rho * (Div(uOld) - Div(meshVelocity));

    VectorGF uConv(uh);
    uConv = uOld;
    VectorGF vmsSubOld(uh);
    vmsSubOld = zero;

    PETSc::Variational::TrialFunction vmsPiTilde(ph);
    PETSc::Variational::TestFunction vmsScalarTest(ph);
    PETSc::Variational::TrialFunction vmsUp(uh);
    PETSc::Variational::TrialFunction vmsSub(uh);
    PETSc::Variational::TestFunction vmsVp(uh);

    const auto vmsConvectionTarget = Mult(Jacobian(uConv), uConv);

    auto cellSize = [](const Point& pp) {
      return std::pow(pp.getPolytope().getMeasure(), 1.0 / pp.getPolytope().getDimension());
    };
    auto tau1At = [&](const Point& pp) -> Real {
      const auto uc = uConv.getValue(pp);
      const Real nu = m.muF / rho;
      const Real hK = cellSize(pp);
      const Real speed = std::sqrt(Math::dot(uc, uc));
      return 1.0 / (4.0 * nu / (hK * hK) + 2.0 * speed / hK);
    };
    auto vmsTauAt = [&](const Point& pp) -> Real {
      return cfg.vmsScale / (rho / dt + rho / tau1At(pp));
    };
    RealFunction vmsTauFn = [&](const Point& pp) -> Real { return vmsTauAt(pp); };
    auto sqrtTauCAt = [&](const Point& pp) -> Real {
      const Real hK = cellSize(pp);
      return std::sqrt(
        std::max<Real>(0.0, cfg.gradDivScale * rho * hK * hK / (4.0 * tau1At(pp))));
    };
    RealFunction sqrtTauCFn = [&](const Point& pp) -> Real { return sqrtTauCAt(pp); };
    RealFunction tauCFn = [&](const Point& pp) -> Real {
      const Real s = sqrtTauCAt(pp);
      return s * s;
    };
    RealFunction tauPFn = [&](const Point& pp) -> Real {
      return cfg.pgpScale * tau1At(pp) / rho;
    };

    auto vmsSubUpdate = VectorFunction(dim, [&](const Point& pp) {
      const auto conv = vmsConvectionTarget.getValue(pp);
      const auto proj = vmsUp.getSolution().getValue(pp);
      const auto old = vmsSubOld.getValue(pp);
      const Real tau = vmsTauAt(pp);
      Vec2 out(2);
      for (Index c = 0; c < 2; ++c)
        out(c) = tau * rho * (old(c) / dt - (conv(c) - proj(c)));
      return out;
    });

    Problem vmsL2Conv(vmsUp, vmsVp);
    vmsL2Conv = Integral(vmsUp, vmsVp) - Integral(vmsConvectionTarget, vmsVp);
    Problem vmsSubProj(vmsSub, vmsVp);
    vmsSubProj = Integral(vmsSub, vmsVp) - Integral(vmsSubUpdate, vmsVp);
    Problem vmsPiTildeProj(vmsPiTilde, vmsScalarTest);
    vmsPiTildeProj = Integral(vmsPiTilde, vmsScalarTest)
      - Integral(sqrtTauCFn * Div(uOld), vmsScalarTest);

    auto solveMass = [](auto& problem) {
      problem.assemble();
      Solver::KSP ksp(problem);
      ksp.setPrefix("fsitest_mass_");
      ksp.solve();
    };

    // Consistency compensation of the interface convective term for the MMS
    // data: the term vanishes on the exact solution only when u = ddot.
    const auto convectiveCompensation = VectorFunction(dim, [&](const Point& pf) {
      const Vec2 g = gUAtFluid(pf);
      const Vec2 ue = evalMMS(MMS::fluidVelocity, pf);
      const auto nf = normalFluid(pf);
      const Real gn = g(0) * nf(0) + g(1) * nf(1);
      return Vec2(0.5 * rho * gn * ue);
    });

    const auto interfaceTransport = uOld - ddotF;
    const Real pspgR = cfg.pspgResidualScale * rho;

    using namespace Rodin::Examples::Heart;

    // Fluid form (17) WITHOUT the Robin terms; those are added algebraically
    // with M_Sigma after assembly (see addInterfaceTerms).
    Problem flow(u, p, v, q);
    flow = (0.5 * rho / dt) * Integral(u, v)
      + rho * Integral(Dot(convU, v))
      + Integral(divCoefficient * Dot(u, v))
      + 2.0 * m.muF * Integral(symU, symV)
      - Integral(p, Div(v)) + Integral(Div(u), q)
      - Integral(fluidForce, v)
      + VMSConvectionBilinearIntegrator(u, v, uConv, vmsTauFn, rho)
      - VMSConvectionLinearIntegrator(
          v, vmsSub.getSolution(), uConv, vmsUp.getSolution(), vmsTauFn, rho, dt)
      + VMSGradDivBilinearIntegrator(u, v, tauCFn)
      - VMSGradDivLinearIntegrator(v, vmsPiTilde.getSolution(), sqrtTauCFn)
      // PSPG: tau_p grad q . R_M (pspgResidualScale = 0: Brezzi-Pitkaranta).
      + Integral(tauPFn * Grad(p), Grad(q))
      + (pspgR / dt) * Integral(tauPFn * u, Grad(q))
      - (pspgR / dt) * Integral(tauPFn * uOld, Grad(q))
      + pspgR * Integral(tauPFn * convU, Grad(q))
      - cfg.pspgResidualScale * Integral(tauPFn * fluidForce, Grad(q))
      // Interface convective term of (13) on Sigma^n + MMS compensation.
      - 0.5 * rho *
          BoundaryIntegral(Dot(interfaceTransport, normalFluid) * Dot(u, v))
            .over(BoundaryFluid::FSI)
      + BoundaryIntegral(convectiveCompensation, v).over(BoundaryFluid::FSI)
      + DirichletBC(u, uExact)
          .on(BoundaryFluid::Bottom, BoundaryFluid::Left, BoundaryFluid::Right);

    PETSc::Variational::TestFunction vMass(uh);
    LinearForm<VectorFES, ::Vec> massOld(vMass);
    massOld = (rho / dt) * Integral(uOld, vMass);

    // A += scale M on the velocity block, b += rhs on the velocity rows.
    // Dirichlet rows are left alone; Dirichlet COLUMNS were eliminated by the
    // assembly (MatZeroRowsColumns), so their contribution goes to b.
    auto addToFlow = [&](::Mat M, Real scale, ::Vec rhs, const std::vector<PetscInt>* rows) {
      ::Mat A = flow.getLinearSystem().getOperator();
      ::Vec b = flow.getLinearSystem().getVector();
      const PetscInt rOff = static_cast<PetscInt>(flow.getTestOffsets()[0]);
      const PetscInt cOff = static_cast<PetscInt>(flow.getTrialOffsets()[0]);
      std::vector<PetscInt> all;
      if (!rows)
      {
        all.resize(uh.getSize());
        for (size_t i = 0; i < all.size(); ++i)
          all[i] = static_cast<PetscInt>(i);
        rows = &all;
      }
      const PetscScalar* rr = nullptr;
      if (rhs)
        VecGetArrayRead(rhs, &rr);
      for (const PetscInt i : *rows)
      {
        if (isDirichlet[i])
          continue;
        if (M && scale != 0.0)
        {
          PetscInt nc = 0;
          const PetscInt* cols = nullptr;
          const PetscScalar* vals = nullptr;
          MatGetRow(M, i, &nc, &cols, &vals);
          for (PetscInt j = 0; j < nc; ++j)
          {
            if (vals[j] == PetscScalar(0))
              continue;
            if (isDirichlet[cols[j]])
              VecSetValue(b, rOff + i, -scale * vals[j] * uDir[cols[j]], ADD_VALUES);
            else
              MatSetValue(A, rOff + i, cOff + cols[j], scale * vals[j], ADD_VALUES);
          }
          MatRestoreRow(M, i, &nc, &cols, &vals);
        }
        if (rr && rr[i] != PetscScalar(0))
          VecSetValue(b, rOff + i, rr[i], ADD_VALUES);
      }
      if (rhs)
        VecRestoreArrayRead(rhs, &rr);
      MatAssemblyBegin(A, MAT_FINAL_ASSEMBLY);
      MatAssemblyEnd(A, MAT_FINAL_ASSEMBLY);
      VecAssemblyBegin(b);
      VecAssemblyEnd(b);
    };

    // Robin terms of (17): A += alpha M_Sigma, b += M_Sigma (alpha (ddot + gU) + lambda).
    ::Vec sigmaData = nullptr;
    ::Vec sigmaRhs = nullptr;
    VecDuplicate(uOld.getData(), &sigmaData);
    VecDuplicate(uOld.getData(), &sigmaRhs);
    auto addInterfaceTerms = [&]() {
      VecZeroEntries(sigmaData);
      for (const auto& iv : sigma)
      {
        const Vec2 g = evalAt(MMS::interfaceKinematicMismatch, iv.X);
        for (Index c = 0; c < 2; ++c)
        {
          const Index i = fdof(iv.fluid, c);
          VecSetValue(sigmaData, static_cast<PetscInt>(i),
            alpha * (ddotF[i] + g(c)) + lambdaF[i], INSERT_VALUES);
        }
      }
      VecAssemblyBegin(sigmaData);
      VecAssemblyEnd(sigmaData);
      MatMult(M0, sigmaData, sigmaRhs);
      addToFlow(M0, alpha, sigmaRhs, &sigmaDofs);
    };

    // Eq. (18), nodal in V_h^g.
    auto updateLambda = [&]() {
      for (const auto& iv : sigma)
      {
        const Vec2 g = evalAt(MMS::interfaceKinematicMismatch, iv.X);
        for (Index c = 0; c < 2; ++c)
        {
          const Index i = fdof(iv.fluid, c);
          lambdaF[i] = lambdaF[i] + alpha * (ddotF[i] + g(c) - uCur[i]);
        }
      }
    };

    // Eq. (19): M_Sigma lambda = r_Sigma, r = F_f(u^n, p^n; .) the residual of
    // the fluid form without the Robin terms.  The two end points of Sigma are
    // fluid Dirichlet nodes (no residual there): they keep the (18) value.
    ::Mat Araw = nullptr;
    ::Vec braw = nullptr;
    auto residualLambda = [&]() {
      ::Vec x = flow.getLinearSystem().getSolution();
      ::Vec r = nullptr;
      VecDuplicate(braw, &r);
      MatMult(Araw, x, r);
      VecAXPY(r, -1.0, braw);
      const PetscInt rOff = static_cast<PetscInt>(flow.getTestOffsets()[0]);
      const size_t nI = sigma.size();
      const PetscScalar* rr = nullptr;
      VecGetArrayRead(r, &rr);
      for (Index c = 0; c < 2; ++c)
      {
        std::vector<PetscInt> idx(nI);
        for (size_t k = 0; k < nI; ++k)
          idx[k] = static_cast<PetscInt>(fdof(sigma[k].fluid, c));
        Math::Matrix<Real> Mc(nI, nI);
        MatGetValues(M0, static_cast<PetscInt>(nI), idx.data(), static_cast<PetscInt>(nI),
          idx.data(), Mc.data());
        Mc.transposeInPlace(); // PETSc fills row-major, Eigen is column-major
        Math::Vector<Real> rhs(nI);
        for (size_t k = 0; k < nI; ++k)
        {
          if (isDirichlet[idx[k]])
          {
            Mc.row(k).setZero();
            Mc(k, k) = 1.0;
            rhs(k) = lambdaF[idx[k]];
          }
          else
          {
            rhs(k) = rr[rOff + idx[k]];
          }
        }
        const Math::Vector<Real> sol = Mc.partialPivLu().solve(rhs);
        for (size_t k = 0; k < nI; ++k)
        {
          err.lambdaDiff = std::max<Real>(err.lambdaDiff, std::abs(sol(k) - lambdaF[idx[k]]));
          lambdaF[idx[k]] = sol(k);
        }
      }
      VecRestoreArrayRead(r, &rr);
      VecDestroy(&r);
    };

    // Pointwise mode: lambda = sigma_h n J_a at the vertices (P1 projection of
    // the gradient-based traction; J_a = mean length stretch of the two faces).
    const auto gradUCur = Jacobian(uCur);
    const auto tractionFSI =
      pCur * normalFluid - m.muF * Mult(gradUCur + Transpose(gradUCur), normalFluid);
    auto pointwiseLambda = [&]() {
      tractionPW.project(Region::Faces, tractionFSI, BoundaryFluid::FSI);
      std::map<Index, std::pair<Real, int>> stretch;
      for (auto it = meshFluid.getBoundary(); it; ++it)
      {
        if (it->getAttribute() != BoundaryFluid::FSI)
          continue;
        const auto& vtx = it->getVertices();
        const Real l = (meshFluid.getVertexCoordinates(vtx[1])
                        - meshFluid.getVertexCoordinates(vtx[0])).norm();
        const Real l0 = (referenceVertices[vtx[1]] - referenceVertices[vtx[0]]).norm();
        for (Index k = 0; k < 2; ++k)
        {
          stretch[vtx[k]].first += l / l0;
          stretch[vtx[k]].second += 1;
        }
      }
      for (const auto& iv : sigma)
      {
        const auto& [sum, cnt] = stretch[iv.fluid];
        for (Index c = 0; c < 2; ++c)
        {
          const Index i = fdof(iv.fluid, c);
          lambdaF[i] = -tractionPW[i] * sum / cnt; // tractionFSI = -sigma n
        }
      }
    };

    // ---- ALE ---------------------------------------------------------------
    PETSc::Variational::TrialFunction dMove(uh);
    PETSc::Variational::TestFunction vMove(uh);
    Problem ale(dMove, vMove);
    ale = Integral(Jacobian(dMove), Jacobian(vMove))
      + DirichletBC(dMove, liftData).on(BoundaryFluid::FSI)
      + DirichletBC(dMove, zero)
          .on(BoundaryFluid::Bottom, BoundaryFluid::Left, BoundaryFluid::Right);

    // ---- solid (mid-point, SNES on the increment) ------------------------
    Solid::NeoHookean law(m.lamS, m.muS);
    // d P(d^{n-1/2}) / d d^n = (1/2) K(d^{n-1/2}); P is linear in (lambda, mu).
    Solid::NeoHookean halfLaw(0.5 * m.lamS, 0.5 * m.muS);
    Solid::InternalVirtualWorkTangent solidTangent(halfLaw, d, w, dMid);
    Solid::InternalVirtualWorkResidual solidInternal(law, w, dMid);

    Problem solid(d, w);
    solid = solidMass * Integral(d, w) + solidTangent
      + solidMass * Integral(dState, w) - solidMass * Integral(dPred, w)
      + solidInternal
      - Integral(solidForce, w)
      - BoundaryIntegral(solidTopTraction, w).over(BoundarySolid::Top)
      + DirichletBC(d, zero).on(BoundarySolid::Sides)
      // Robin terms of (16):
      //   alpha (ddot^{n-1/2} - u^{n,k-1} + gU) + lambda^{n,k-1} - h  on Sigma.
      + (alpha / dt) * BoundaryIntegral(d, w).over(BoundarySolid::FSI)
      + (alpha / dt) * BoundaryIntegral(dState, w).over(BoundarySolid::FSI)
      - (alpha / dt) * BoundaryIntegral(dOld, w).over(BoundarySolid::FSI)
      - alpha * BoundaryIntegral(uS, w).over(BoundarySolid::FSI)
      + alpha * BoundaryIntegral(gUSolid, w).over(BoundarySolid::FSI)
      + BoundaryIntegral(lambdaS, w).over(BoundarySolid::FSI)
      - BoundaryIntegral(hSolid, w).over(BoundarySolid::FSI);

    solid.assemble();
    Solver::KSP kspSolid(solid);
    Solver::SNES snes(kspSolid);
    snes.setTolerances(1.0e-12, 1.0e-10, 1.0e-12, 50, 10000);
    snes.setStateUpdate([&](const PETSc::Math::Vector& state) {
      etaState.setData(state, 0);
      dState = dOld;
      dState += etaState;
      dMid = dState;
      dMid += dOld;
      dMid *= 0.5;
    });

    // ---- output ---------------------------------------------------------------
    std::unique_ptr<IO::XDMF> xdmfFluid, xdmfSolid;
    if (cfg.xdmf)
    {
      const std::string base = cfg.resultsDir + "/L" + std::to_string(level) + "_";
      xdmfFluid = std::make_unique<IO::XDMF>(base + "fluid");
      xdmfFluid->setMesh(meshFluid);
      xdmfFluid->add("u", uOld);
      xdmfFluid->add("p", pOld);
      xdmfFluid->add("w", meshVelocity);
      xdmfFluid->add("lambda", lambdaF);
      xdmfSolid = std::make_unique<IO::XDMF>(base + "solid");
      xdmfSolid->setMesh(meshSolid);
      xdmfSolid->add("d", dOld);
      xdmfSolid->add("d_exact", dExact);
      xdmfFluid->write(0.0).flush();
      xdmfSolid->write(0.0).flush();
    }

    std::ofstream history(cfg.resultsDir + "/history_L" + std::to_string(level) + ".csv");
    history << "t,e_u,e_d\n";

    // ---- error functionals ------------------------------------------------------
    auto errVec = [&](void (*f)(Real, Real, Real, const MMS::MMSParams&, Real*)) {
      return [&, f](const Point& pt, const auto& gh) {
        const auto a = gh(pt);
        const Vec2 e = evalMMS(f, pt);
        return (a(0) - e(0)) * (a(0) - e(0)) + (a(1) - e(1)) * (a(1) - e(1));
      };
    };
    auto errP = [&](const Point& pt, const auto& gh) {
      const Real e = pExact(pt);
      const Real a = gh(pt);
      return (a - e) * (a - e);
    };
    auto interfaceError = [&]() {
      Real sum = 0.0;
      for (auto it = meshSolid.getBoundary(); it; ++it)
      {
        if (it->getAttribute() != BoundarySolid::FSI)
          continue;
        const Real len = it->getMeasure();
        for (const auto& [s, wq] : gauss3())
        {
          Math::SpatialPoint rc(1);
          rc(0) = s;
          const Point pt(*it, rc);
          const auto a = dState(pt);
          const Vec2 e = evalMMS(MMS::solidDisplacement, pt);
          sum += wq * len * ((a(0) - e(0)) * (a(0) - e(0)) + (a(1) - e(1)) * (a(1) - e(1)));
        }
      }
      return std::sqrt(sum);
    };
    auto slipError = [&]() {
      // || u_h - ddot_h - gU ||_{L2(Sigma^n)}: the discrete kinematic defect.
      Real sum = 0.0;
      for (auto it = meshFluid.getBoundary(); it; ++it)
      {
        if (it->getAttribute() != BoundaryFluid::FSI)
          continue;
        const Real len = it->getMeasure();
        for (const auto& [s, wq] : gauss3())
        {
          const Point pt = pointOnSegment(meshFluid, *it, s);
          const auto a = uCur(pt);
          const auto dd = ddotF(pt);
          const Vec2 g = gUAtFluid(pt);
          const Real e0 = a(0) - dd(0) - g(0), e1 = a(1) - dd(1) - g(1);
          sum += wq * len * (e0 * e0 + e1 * e1);
        }
      }
      return std::sqrt(sum);
    };

    // ======================================================================
    // Time loop: Algorithm 1 (+ Appendix A corrections when K > 1).
    // ======================================================================
    for (size_t step = 1; step <= nsteps; ++step)
    {
      const Real tN = static_cast<Real>(step) * dt;
      const Real tHalf = tN - 0.5 * dt;

      // Mid-point predictor d^{n-1} + dt ddot^{n-1}.
      dPred = vOld;
      dPred *= dt;
      dPred += dOld;

      // Old configuration Omega^{n-1}: explicit mass vector and s_Omega matrix.
      moveMeshWithVertexDisplacement(meshFluid, referenceVertices, uh, aleDispOld);
      massOld.assemble();
      massOldMatrix.assemble();

      // Update fluid domain: Omega^n = lift of d^{n-1}.
      liftData = zero;
      for (const auto& iv : sigma)
        for (Index c = 0; c < 2; ++c)
          liftData[fdof(iv.fluid, c)] = dOld[sdof(iv.solid, c)];
      restoreMeshToReference(meshFluid, referenceVertices);
      ale.assemble();
      Solver::KSP(ale).solve();
      aleDisp.setData(dMove.getSolution().getData());
      meshVelocity = aleDisp;
      meshVelocity -= aleDispOld;
      meshVelocity *= 1.0 / dt;
      moveMeshWithVertexDisplacement(meshFluid, referenceVertices, uh, aleDisp);

      tNow = tN;
      uDir = uExact;

      for (size_t k = 1; k <= cfg.couplingIterations; ++k)
      {
        // Robin data for the solid: u^{n,k-1}, lambda^{n,k-1}.
        uS = zero;
        lambdaS = zero;
        for (const auto& iv : sigma)
          for (Index c = 0; c < 2; ++c)
          {
            uS[sdof(iv.solid, c)] = uCur[fdof(iv.fluid, c)];
            lambdaS[sdof(iv.solid, c)] = lambdaF[fdof(iv.fluid, c)];
          }

        // Solve solid (16), data at t^{n-1/2}.
        tNow = tHalf;
        snes.solve();
        if (!snes.converged())
        {
          std::cerr << "  [L" << level << "] solid SNES failed at step " << step << '\n';
          err.ok = false;
          break;
        }

        // ddot^{n-1/2} on Sigma.
        ddotF = zero;
        for (const auto& iv : sigma)
          for (Index c = 0; c < 2; ++c)
            ddotF[fdof(iv.fluid, c)] =
              (dState[sdof(iv.solid, c)] - dOld[sdof(iv.solid, c)]) / dt;

        // Solve fluid (17), data at t^n.
        tNow = tN;
        uConv = uOld;
        uConv -= meshVelocity;
        solveMass(vmsL2Conv);
        solveMass(vmsSubProj);
        solveMass(vmsPiTildeProj);

        flow.assemble();
        addToFlow(massOldMatrix.getOperator(), 0.5 * rho / dt, massOld.getVector(), nullptr);
        if (cfg.lambdaMode == Config::LambdaMode::Residual)
        {
          if (Araw)
            MatDestroy(&Araw);
          if (braw)
            VecDestroy(&braw);
          MatDuplicate(flow.getLinearSystem().getOperator(), MAT_COPY_VALUES, &Araw);
          VecDuplicate(flow.getLinearSystem().getVector(), &braw);
          VecCopy(flow.getLinearSystem().getVector(), braw);
        }
        addInterfaceTerms();
        Solver::KSP(flow).solve();
        uCur.setData(u.getSolution().getData());
        pCur.setData(p.getSolution().getData());

        // Fluid-stress update.
        switch (cfg.lambdaMode)
        {
          case Config::LambdaMode::Update:
            updateLambda();
            break;
          case Config::LambdaMode::Residual:
            updateLambda();
            residualLambda();
            break;
          case Config::LambdaMode::Pointwise:
            pointwiseLambda();
            break;
        }
      }
      if (!err.ok)
        break;

      // ddot^n = 2 ddot^{n-1/2} - ddot^{n-1}.
      vNew = dState;
      vNew -= dOld;
      vNew *= 2.0 / dt;
      vNew -= vOld;

      tNow = tN;
      const Real eU = l2Error(meshFluid, uCur, errVec(MMS::fluidVelocity));
      const Real eD = l2Error(meshSolid, dState, errVec(MMS::solidDisplacement));
      history << tN << ',' << eU << ',' << eD << '\n';
      err.uMax = std::max(err.uMax, eU);
      err.dMax = std::max(err.dMax, eD);
      if (!std::isfinite(eU) || !std::isfinite(eD))
      {
        std::cerr << "  [L" << level << "] non-finite error at step " << step << '\n';
        err.ok = false;
        break;
      }

      if (step == nsteps)
      {
        err.u = eU;
        err.d = eD;
        err.p = l2Error(meshFluid, pCur, errP);
        err.v = l2Error(meshSolid, vNew, errVec(MMS::solidVelocity));
        err.dSigma = interfaceError();
        err.interfaceSlip = slipError();
      }

      uOld.setData(uCur.getData());
      pOld.setData(pCur.getData());
      vmsSubOld.setData(vmsSub.getSolution().getData());
      dOld.setData(dState.getData());
      vOld.setData(vNew.getData());
      aleDispOld.setData(aleDisp.getData());

      if (xdmfFluid)
      {
        dExact = dExactFn;
        xdmfFluid->write(tN).flush();
        xdmfSolid->write(tN).flush();
      }
    }

    if (Araw)
      MatDestroy(&Araw);
    if (braw)
      VecDestroy(&braw);
    VecDestroy(&sigmaData);
    VecDestroy(&sigmaRhs);

    if (xdmfFluid)
    {
      xdmfFluid->close();
      xdmfSolid->close();
    }

    std::cout << "  [L" << level << "] N = " << N << "  dt = " << dt << "  steps = " << nsteps
              << "  alpha = " << alpha << "  |u-u_h| = " << err.u << "  |d-d_h| = " << err.d;
    if (cfg.lambdaMode == Config::LambdaMode::Residual)
      std::cout << "  max|lambda(19) - lambda(18)| = " << err.lambdaDiff;
    std::cout << std::endl;
    return err;
  }
} // namespace

int main(int argc, char** argv)
{
  PetscInitialize(&argc, &argv, PETSC_NULLPTR, PETSC_NULLPTR);
  setPETScDefault("-ksp_type", "preonly");
  setPETScDefault("-pc_type", "lu");
  setPETScDefault("-pc_factor_mat_solver_type", "mumps");
  // L2 projections of the VMS subscales: SPD mass matrices.
  setPETScDefault("-fsitest_mass_ksp_type", "cg");
  setPETScDefault("-fsitest_mass_pc_type", "jacobi");
  setPETScDefault("-fsitest_mass_ksp_rtol", "1e-12");

  int status = 0;
  try
  {
    const Config cfg = readOptions();
    std::filesystem::create_directories(cfg.resultsDir);

    std::cout << "Robin-Robin ALE FSI manufactured-solution test\n"
              << "  fluid P1/P1 VMS (rho=" << cfg.mms.rhoF << ", mu=" << cfg.mms.muF
              << "), solid P1 neo-Hookean mid-point (rho=" << cfg.mms.rhoS
              << ", lambda=" << cfg.mms.lamS << ", mu=" << cfg.mms.muS << ")\n"
              << "  A=" << cfg.mms.A << " B=" << cfg.mms.B << " P0=" << cfg.mms.P0
              << "  T=" << cfg.T << "  K=" << cfg.couplingIterations
              << "  lambda: "
              << (cfg.lambdaMode == Config::LambdaMode::Pointwise ? "pointwise"
                  : cfg.lambdaMode == Config::LambdaMode::Residual ? "residual (eq. 19)"
                                                                   : "update (eq. 18)")
              << "  PSPG residual=" << cfg.pspgResidualScale
              << "\n";

    std::vector<Errors> errs;
    for (size_t l = 0; l < cfg.levels; ++l)
    {
      errs.push_back(runLevel(cfg, l));
      if (!errs.back().ok)
      {
        status = 1;
        break;
      }
    }

    std::ofstream csv("fsitest_convergence.csv");
    csv << "N,dt,steps,e_u,e_p,e_d,e_dt,e_d_sigma,e_u_linf,e_d_linf,slip\n";
    std::cout << "\n  N     dt        |u-uh|    ord   |p-ph|    ord   |d-dh|    ord"
                 "   |dt-vh|   ord   |d-dh|_S  ord   max|u-uh| ord   slip\n";
    for (size_t i = 0; i < errs.size(); ++i)
    {
      const auto& e = errs[i];
      auto ord = [&](Real Errors::*f) {
        std::ostringstream os;
        if (i == 0)
          os << "  -  ";
        else
          os << std::fixed << std::setprecision(2) << std::setw(5)
             << order(errs[i - 1].*f, e.*f);
        return os.str();
      };
      std::cout << std::setw(4) << e.n << "  " << std::scientific << std::setprecision(2)
                << e.dt << "  " << e.u << ' ' << ord(&Errors::u) << "  " << e.p << ' '
                << ord(&Errors::p) << "  " << e.d << ' ' << ord(&Errors::d) << "  " << e.v
                << ' ' << ord(&Errors::v) << "  " << e.dSigma << ' '
                << ord(&Errors::dSigma) << "  " << std::scientific << e.uMax << ' '
                << ord(&Errors::uMax) << "  " << e.interfaceSlip << '\n';
      csv << e.n << ',' << e.dt << ',' << e.steps << ',' << e.u << ',' << e.p << ','
          << e.d << ',' << e.v << ',' << e.dSigma << ',' << e.uMax << ',' << e.dMax << ','
          << e.interfaceSlip << '\n';
    }
    std::cout << "\nWritten fsitest_convergence.csv" << std::endl;
  }
  catch (const std::exception& e)
  {
    std::cerr << "FSITest failed: " << e.what() << '\n';
    status = 1;
  }

  PetscFinalize();
  return status;
}
