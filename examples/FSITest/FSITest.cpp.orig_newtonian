  {
      size_t levels = 4;
      size_t n0 = 8;            // fluid cells per side on level 0 (multiple of 4 / H)
      Real dt0 = 0.04;
      Real T = 0.4;
      Real H = 0.25;            // solid thickness
      Real robinGamma = 1.0;    // alpha = gamma sqrt(rho_s E)
      Real robinAlpha = 0.0;    // > 0 overrides
      size_t couplingIterations = 1;
      Real couplingTolerance = 1.0e-10;
      bool xdmf = false;
      /// How lambda^n (fluid stress on the reference interface) is built.
      /// Update is the production definition; Residual and Pointwise exist to
      /// compare against it.
      enum class LambdaMode { Update, Residual, Pointwise };
      LambdaMode lambdaMode = LambdaMode::Update;
      // VMS / PSPG scalings (same meaning as the Heart P1/P1 solver).
      Real vmsScale = 1.0;
      Real gradDivScale = 1.0;
      Real pgpScale = 1.0;
      /// 0: Brezzi-Pitkaranta  tau_p (grad p, grad q);  1: full residual PSPG.
      Real pspgResidualScale = 1.0;
      std::string resultsDir = "results_fsitest";
      MMS::MMSParams mms;
  };

