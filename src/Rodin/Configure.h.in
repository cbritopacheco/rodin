/** @cond */
#ifndef RODIN_CONFIGURE_H
#define RODIN_CONFIGURE_H
/** @endcond */

/**
 * @file
 * @brief Build configuration and feature-selection macros for Rodin.
 *
 * CMake generates @c Rodin/Configure.h from this template. Include the
 * generated header to inspect the library version and enabled backends;
 * optional feature macros are defined only when their feature is enabled.
 *
 * @see @ref configuration "Configuration guide"
 *
 * ## Representative use
 *
 * @code{.cpp}
 * #include <Rodin/Configure.h>
 * #if defined(RODIN_USE_MPI)
 * // Code requiring the MPI backend.
 * #endif
 * @endcode
 *
 * ## Module-specific controls
 *
 * Controls declared by individual modules remain documented on their own
 * header pages: @ref RODIN_GEOMETRY_REQUIRE_INCIDENCE for mesh connectivity,
 * @ref RODIN_QF_GRUNDMANNMOLLER_MAX_ORDER for quadrature capacity, and
 * @ref RODIN_VARIATIONAL_H1ELEMENT_MAX_VECTOR_DIMENSION for H1 vector capacity.
 */

/// @brief Rodin version string.
#define RODIN_VERSION "@RODIN_VERSION@"

/// @brief Rodin major version number.
#define RODIN_VERSION_MAJOR @RODIN_VERSION_MAJOR@

/// @brief Rodin minor version number.
#define RODIN_VERSION_MINOR @RODIN_VERSION_MINOR@

/// @brief Rodin patch version number.
#define RODIN_VERSION_PATCH @RODIN_VERSION_PATCH@

/// @brief Encoded Rodin version number.
#define RODIN_VERSION_CODE @RODIN_VERSION_CODE@

/**
 * @brief Indicates if Rodin is built with Python support.
 *
 * # Utilization
 *
 * @code{.cpp}
 *  #ifndef RODIN_WITH_PY
 *  // Code depending on Python support
 *  #endif
 * @endcode
 */
#cmakedefine RODIN_WITH_PY

/**
 * @brief Indicates if Rodin::Plot is built.
 * @code{.cpp}
 *  #ifndef RODIN_WITH_PLOT
 *  // Code depending on Rodin::Plot support
 *  #endif
 * @endcode
 */
#cmakedefine RODIN_WITH_PLOT

/**
 * @brief Indicates if Rodin is built with MPI support.
 *
 * # Utilization
 *
 * @code{.cpp}
 *  #ifndef RODIN_USE_MPI
 *  // Code depending on MPI support
 *  #endif
 * @endcode
 */
#cmakedefine RODIN_USE_MPI

/**
 * @brief Indicates if Rodin is built with OpenMP support.
 *
 * # Utilization
 *
 * @code{.cpp}
 * #ifndef RODIN_USE_OPENMP
 * // Code depending on OpenMP support
 * #endif
 * @endcode
 */
#cmakedefine RODIN_USE_OPENMP

/**
 * @brief Indicates if Rodin is built with SuiteSparse support.
 *
 * # Utilization
 *
 * @code{.cpp}
 * #ifndef RODIN_USE_UMFPACK
 * // Code depending on UMFPACK
 * #endif
 * @endcode
 */
#cmakedefine RODIN_USE_UMFPACK

/**
 * @brief Indicates if Rodin is built with SuiteSparse:ParU support.
 *
 * # Utilization
 *
 * @code{.cpp}
 * #ifndef RODIN_USE_PARU
 * // Code depending on ParU
 * #endif
 * @endcode
 */
#cmakedefine RODIN_USE_PARU

/**
 * @brief Indicates if Rodin is built with MUMPS support.
 *
 * # Utilization
 *
 * @code{.cpp}
 * #ifndef RODIN_USE_MUMPS
 * // Code depending on MUMPS
 * #endif
 * @endcode
 */
#cmakedefine RODIN_USE_MUMPS

/**
 * @brief Indicates if Rodin is built with SuiteSparse support.
 *
 * # Utilization
 *
 * @code{.cpp}
 * #ifndef RODIN_USE_SPQR
 * // Code depending on SPQR
 * #endif
 * @endcode
 */
#cmakedefine RODIN_USE_SPQR

/**
 * @brief Indicates if Rodin is built with SuiteSparse support.
 *
 * # Utilization
 *
 * @code{.cpp}
 * #ifndef RODIN_USE_CHOLMOD
 * // Code depending on CHOLMOD
 * #endif
 * @endcode
 */
#cmakedefine RODIN_USE_CHOLMOD

/// @brief Indicates if Rodin warnings are silenced.
#cmakedefine RODIN_SILENCE_WARNINGS

/**
 * @brief Indicates if Rodin exceptions are silenced.
 *
 * If defined, this directive will prevent Rodin from outputting the error
 * messages. It does not prevent the exception from being thrown.
 */
#cmakedefine RODIN_SILENCE_EXCEPTIONS

/**
 * @brief Indicates the Rodin resources directory.
 *
 * # Utilization
 *
 * @code{.cpp}
 * std::cout << RODIN_RESOURCES_DIR << std::endl;
 * @endcode
 */
#cmakedefine RODIN_RESOURCES_DIR "@RODIN_RESOURCES_DIR@"

/**
 * @brief Indicates the Rodin third-party source directory.
 *
 * # Utilization
 *
 * @code{.cpp}
 * std::cout << RODIN_THIRD_PARTY_DIR << std::endl;
 * @endcode
 */
#cmakedefine RODIN_THIRD_PARTY_DIR "@RODIN_THIRD_PARTY_DIR@"

/**
 * @brief Indicates if Rodin is built with thread safety enabled.
 *
 * # Utilization
 *
 * @code{.cpp}
 * #ifdef RODIN_THREAD_SAFE
 *   // Code that requires thread safety features.
 * #endif
 * @endcode
 */
#cmakedefine RODIN_THREAD_SAFE

/**
 * @brief Indicates if Rodin supports multithreading.
 *
 * # Utilization
 *
 * @code{.cpp}
 * #ifdef RODIN_MULTITHREADED
 *   // Code that leverages multithreading capabilities.
 * #endif
 * @endcode
 */
#cmakedefine RODIN_MULTITHREADED

/**
 * @brief Indicates if Rodin is built with Apple Accelerate support.
 *
 * # Utilization
 *
 * @code{.cpp}
 * #ifdef RODIN_USE_APPLE_ACCELERATE
 *   // Code that uses the Apple Accelerate framework for optimized computations.
 * #endif
 * @endcode
 */
#cmakedefine RODIN_USE_APPLE_ACCELERATE

/**
 * @brief Indicates if Rodin is built with Scotch support.
 *
 * # Utilization
 *
 * @code{.cpp}
 * #ifdef RODIN_USE_SCOTCH
 *   // Code that uses the Scotch library for partioning.
 * #endif
 * @endcode
 */
#cmakedefine RODIN_USE_SCOTCH

/// @brief Indicates the maximal space dimension.
#define RODIN_MAXIMAL_SPACE_DIMENSION 3

/// @brief Maximum number of vertices supported by a polytope.
#define RODIN_MAXIMUM_POLYTOPE_VERTICES 8

/**
 * @brief Legacy default tolerance intended for fuzzy scalar comparisons.
 *
 * Absolute threshold in the compared values' units; the value is a numerical
 * policy, not a scale-independent error bound. Currently unused in Rodin's
 * implementation; retained as a configuration macro for downstream users.
 */
#define RODIN_FUZZY_CONSTANT 1e-5

/** @cond */
#endif
/** @endcond */
