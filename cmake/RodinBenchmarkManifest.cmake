# Registration is shared by executable configuration and documentation-only builds.
function(rodin_register_benchmark target)
  cmake_parse_arguments(PARSE_ARGV 1 _entry "" "PATH;DESCRIPTION;FORMAT;PROFILE;METRIC;CASE_BATCH" "RANKS;ARGS;MPI_ARGS")
  if(_entry_UNPARSED_ARGUMENTS OR NOT _entry_PATH OR NOT _entry_DESCRIPTION)
    message(FATAL_ERROR "Benchmark ${target} needs PATH and DESCRIPTION")
  endif()
  if(NOT TARGET "${target}" AND NOT RODIN_BENCHMARK_METADATA_ONLY)
    message(FATAL_ERROR "Unknown benchmark target: ${target}")
  endif()
  if(_entry_PATH MATCHES "(^/|(^|/)\\.\\.(/|$)|[\t\r\n;])")
    message(FATAL_ERROR "Invalid benchmark publication path: ${_entry_PATH}")
  endif()
  get_filename_component(_description "${_entry_DESCRIPTION}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
  if(NOT EXISTS "${_description}")
    message(FATAL_ERROR "Missing benchmark description: ${_description}")
  endif()
  if(NOT _entry_CASE_BATCH)
    set(_entry_CASE_BATCH 256)
  endif()
  if(NOT _entry_CASE_BATCH MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "CASE_BATCH must be positive for ${target}")
  endif()
  set(_entry_DESCRIPTION "${_description}")
  get_property(_registered GLOBAL PROPERTY RODIN_BENCHMARK_REGISTRATIONS)
  if(NOT target IN_LIST _registered)
    set_property(GLOBAL APPEND PROPERTY RODIN_BENCHMARK_REGISTRATIONS "${target}")
  endif()
  foreach(_field PATH DESCRIPTION FORMAT PROFILE METRIC RANKS ARGS MPI_ARGS CASE_BATCH)
    set_property(GLOBAL PROPERTY RODIN_BENCHMARK_${target}_${_field} "${_entry_${_field}}")
    if(TARGET "${target}")
      set_property(TARGET "${target}" PROPERTY RODIN_BENCHMARK_${_field} "${_entry_${_field}}")
    endif()
  endforeach()
endfunction()

function(rodin_collect_benchmarks directory)
  get_property(_targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  foreach(_target IN LISTS _targets)
    get_target_property(_type "${_target}" TYPE)
    get_target_property(_source "${_target}" SOURCE_DIR)
    file(RELATIVE_PATH _owner "${PROJECT_SOURCE_DIR}" "${_source}")
    if(_type MATCHES "^(STATIC|SHARED|MODULE|OBJECT)_LIBRARY$")
      set(_state library)
      set(_executable "")
    elseif(_owner MATCHES "^tests/benchmarks($|/)" AND _type STREQUAL "EXECUTABLE")
      get_property(_path TARGET "${_target}" PROPERTY RODIN_BENCHMARK_PATH)
      if(NOT _path)
        message(FATAL_ERROR "Unregistered benchmark executable: ${_target}")
      endif()
      set(_state registered)
      set(_executable "$<TARGET_FILE:${_target}>")
    else()
      continue()
    endif()
    set(_row "${_target}\t${_owner}\t${_executable}\t${_state}")
    foreach(_field PATH DESCRIPTION FORMAT PROFILE METRIC RANKS ARGS MPI_ARGS CASE_BATCH)
      get_property(_value TARGET "${_target}" PROPERTY RODIN_BENCHMARK_${_field})
      string(APPEND _row "\t${_value}")
    endforeach()
    set_property(GLOBAL APPEND_STRING PROPERTY RODIN_BENCHMARK_MANIFEST "${_row}\n")
  endforeach()
  get_property(_children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(_child IN LISTS _children)
    rodin_collect_benchmarks("${_child}")
  endforeach()
endfunction()

function(rodin_export_benchmarks)
  set_property(GLOBAL PROPERTY RODIN_BENCHMARK_MANIFEST "")
  rodin_collect_benchmarks("${PROJECT_SOURCE_DIR}")
  get_property(_manifest GLOBAL PROPERTY RODIN_BENCHMARK_MANIFEST)
  file(GENERATE OUTPUT "${PROJECT_BINARY_DIR}/RodinBenchmarkTargets-$<CONFIG>.tsv"
    CONTENT "target\towner\texecutable\tstate\tpath\tdescription\tformat\tprofile\tmetric\tranks\targs\tmpi_args\tcase_batch\n${_manifest}")
endfunction()

function(rodin_export_benchmark_descriptions output)
  set(RODIN_BENCHMARK_METADATA_ONLY ON)
  file(GLOB_RECURSE _registries CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/tests/benchmarks/*.benchmarks.cmake")
  foreach(_registry IN LISTS _registries)
    include("${_registry}")
  endforeach()
  get_property(_targets GLOBAL PROPERTY RODIN_BENCHMARK_REGISTRATIONS)
  set(_manifest "target\towner\texecutable\tstate\tpath\tdescription\tformat\tprofile\tmetric\tranks\targs\tmpi_args\tcase_batch\n")
  foreach(_target IN LISTS _targets)
    set(_row "${_target}\t\t\tregistered")
    foreach(_field PATH DESCRIPTION FORMAT PROFILE METRIC RANKS ARGS MPI_ARGS CASE_BATCH)
      get_property(_value GLOBAL PROPERTY RODIN_BENCHMARK_${_target}_${_field})
      string(APPEND _row "\t${_value}")
    endforeach()
    string(APPEND _manifest "${_row}\n")
  endforeach()
  file(WRITE "${output}" "${_manifest}")
endfunction()
