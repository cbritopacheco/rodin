@PACKAGE_INIT@

# Use modern Boost finding mechanism (CMake 3.30+)
if(POLICY CMP0167)
  cmake_policy(SET CMP0167 NEW)
endif()

include(CMakeFindDependencyMacro)

set(_RODIN_CONFIG_MODULE_PATH_SAVED "${CMAKE_MODULE_PATH}")
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

# Eigen3 - We originally developed with 3.4, but newer versions (e.g., 5.x) are compatible
# Note: Not specifying version to allow flexibility with system installations
find_dependency(Boost 1.74 REQUIRED COMPONENTS filesystem serialization)
find_dependency(HDF5 REQUIRED COMPONENTS C)
find_dependency(Threads REQUIRED)
find_dependency(Eigen3 REQUIRED)

# Find optional dependencies if they were used during build
if(@RODIN_MULTITHREADED@)
  find_dependency(Threads REQUIRED)
endif()

if(@RODIN_USE_OPENMP@)
  find_dependency(OpenMP REQUIRED)
endif()

if(@RODIN_USE_MPI@)
  find_dependency(Boost 1.74 REQUIRED COMPONENTS mpi)
endif()

if(@RODIN_USE_KOKKOS@)
  find_dependency(Kokkos 4.2 CONFIG REQUIRED)
  # Match the SYCL dependency setup used when building Rodin itself.
  if(Kokkos_ENABLE_SYCL AND NOT TARGET MKL::MKL)
    set(MKL_INTERFACE lp64 CACHE STRING "Integer interface of oneMKL")
    find_package(MKL CONFIG QUIET)
  endif()
  find_dependency(KokkosKernels CONFIG REQUIRED)
endif()

if(@RODIN_USE_PETSC@)
  find_dependency(PETSc REQUIRED)
endif()

if(@RODIN_USE_MUMPS@)
  find_dependency(MUMPS REQUIRED)
endif()

if(@RODIN_USE_CUDSS@)
  if(NOT Kokkos_ENABLE_CUDA)
    set(Rodin_FOUND FALSE)
    set(Rodin_NOT_FOUND_MESSAGE "Rodin's cuDSS integration requires CUDA-enabled Kokkos.")
    return()
  endif()
  find_dependency(CUDAToolkit REQUIRED)
  find_dependency(cudss CONFIG REQUIRED)
endif()

if(@RODIN_USE_ROCSOLVER@)
  if(NOT Kokkos_ENABLE_HIP)
    set(Rodin_FOUND FALSE)
    set(Rodin_NOT_FOUND_MESSAGE "Rodin's rocSOLVER integration requires HIP-enabled Kokkos.")
    return()
  endif()
  find_dependency(hip CONFIG REQUIRED)
  find_dependency(rocblas CONFIG REQUIRED)
  find_dependency(rocsparse CONFIG REQUIRED)
  find_dependency(rocsolver CONFIG REQUIRED)
endif()

if(@RODIN_USE_HYPRE@)
  find_dependency(HYPRE REQUIRED)
endif()

set(_RODIN_SUITESPARSE_COMPONENTS)
if(@RODIN_USE_UMFPACK@)
  list(APPEND _RODIN_SUITESPARSE_COMPONENTS UMFPACK)
endif()
if(@RODIN_USE_PARU@)
  list(APPEND _RODIN_SUITESPARSE_COMPONENTS ParU)
endif()
if(@RODIN_USE_SPQR@)
  list(APPEND _RODIN_SUITESPARSE_COMPONENTS SPQR)
endif()
if(@RODIN_USE_CHOLMOD@)
  list(APPEND _RODIN_SUITESPARSE_COMPONENTS CHOLMOD)
endif()
if(_RODIN_SUITESPARSE_COMPONENTS)
  find_dependency(SuiteSparse REQUIRED
    COMPONENTS ${_RODIN_SUITESPARSE_COMPONENTS})
endif()
unset(_RODIN_SUITESPARSE_COMPONENTS)

# The OpenMP lowering of icpx miscompiles the assembly loops of Rodin, see the
# top CMakeLists.txt of Rodin: the front end of Clang lowers them instead.
if(@RODIN_USE_OPENMP@ AND CMAKE_CXX_COMPILER_ID STREQUAL "IntelLLVM")
  set_property(TARGET OpenMP::OpenMP_CXX PROPERTY INTERFACE_COMPILE_OPTIONS
    $<$<COMPILE_LANGUAGE:CXX>:-fopenmp=libomp>)
endif()

set(CMAKE_MODULE_PATH "${_RODIN_CONFIG_MODULE_PATH_SAVED}")
unset(_RODIN_CONFIG_MODULE_PATH_SAVED)

include("${CMAKE_CURRENT_LIST_DIR}/RodinTargets.cmake")

