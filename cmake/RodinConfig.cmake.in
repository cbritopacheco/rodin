@PACKAGE_INIT@

# Import Rodin targets first so component dependencies follow the installed
# target graph rather than a second, manually maintained module graph.
include("${CMAKE_CURRENT_LIST_DIR}/RodinTargets.cmake")

# A function scopes dependency variables and CMAKE_MODULE_PATH. The included
# dependency file may return early through find_dependency; this function still
# propagates its result and leaves the consumer's search paths unchanged.
function(_rodin_load_component _RODIN_COMPONENT)
  set(_RODIN_TARGETS)
  set(_RODIN_LINKS)
  set(_RODIN_PENDING "Rodin::${_RODIN_COMPONENT}")
  while(_RODIN_PENDING)
    list(POP_FRONT _RODIN_PENDING _target)
    if(_target IN_LIST _RODIN_TARGETS)
      continue()
    endif()
    list(APPEND _RODIN_TARGETS "${_target}")
    get_target_property(_links "${_target}" INTERFACE_LINK_LIBRARIES)
    list(APPEND _RODIN_LINKS ${_links})
    # Imported link interfaces can wrap dependencies in LINK_ONLY and other
    # generator expressions. Follow only Rodin targets; external packages
    # are discovered by the dependency file below.
    string(REGEX MATCHALL "Rodin::[A-Za-z0-9_:]+" _dependencies "${_links}")
    list(APPEND _RODIN_PENDING ${_dependencies})
  endwhile()
  set(Rodin_FOUND TRUE)
  set(Rodin_FIND_REQUIRED FALSE)
  include("${CMAKE_CURRENT_LIST_DIR}/RodinDependencies.cmake")
  set("Rodin_${_RODIN_COMPONENT}_FOUND" "${Rodin_FOUND}" PARENT_SCOPE)
  if(NOT Rodin_FOUND)
    set(Rodin_NOT_FOUND_MESSAGE "${Rodin_NOT_FOUND_MESSAGE}" PARENT_SCOPE)
  endif()
endfunction()

set(Rodin_FOUND TRUE)
unset(Rodin_NOT_FOUND_MESSAGE)
if(NOT Rodin_FIND_COMPONENTS)
  # Keep the legacy dependency variables visible to existing consumers.
  set(_RODIN_COMPONENT "")
  set(_RODIN_SAVED_MODULE_PATH "${CMAKE_MODULE_PATH}")
  include("${CMAKE_CURRENT_LIST_DIR}/RodinDependencies.cmake")
  set(CMAKE_MODULE_PATH "${_RODIN_SAVED_MODULE_PATH}")
  unset(_RODIN_SAVED_MODULE_PATH)
else()
  foreach(_component IN LISTS Rodin_FIND_COMPONENTS)
    if(TARGET "Rodin::${_component}")
      _rodin_load_component("${_component}")
    else()
      set("Rodin_${_component}_FOUND" FALSE)
      if(Rodin_FIND_REQUIRED_${_component})
        set(Rodin_NOT_FOUND_MESSAGE "Rodin component '${_component}' is not installed.")
      endif()
    endif()
    if(NOT Rodin_${_component}_FOUND AND Rodin_FIND_REQUIRED_${_component})
      set(Rodin_FOUND FALSE)
      return()
    endif()
  endforeach()
endif()
if(Rodin_FOUND)
  unset(Rodin_NOT_FOUND_MESSAGE)
endif()
