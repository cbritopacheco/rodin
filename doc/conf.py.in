RODIN_MODULE_CATEGORIES = {
    'Core': 'Geometry, finite element spaces, variational expressions, assembly and linear algebra form the path from a weak formulation to an algebraic system.',
    'Models': 'Transport, distance construction, regularization, solid mechanics and cardiac models are expressed using the core numerical interfaces.',
    'Parallelism and integrations': 'These modules connect Rodin to distributed execution, external solver backends, mesh adaptation and graph partitioning libraries.',
    'Infrastructure': 'Execution contexts, diagnostics, spatial search, type utilities, serialization and numerical test helpers support the numerical modules.',
