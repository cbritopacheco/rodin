# Rodin house style for new and changed code. Untouched legacy layout does not
# override this configuration. Enforcement in CI is on changed lines only
# (dev/check_format.py); see CONTRIBUTING.md.
#
# Requires clang-format >= 16 (AlignTrailingComments: Leave); CI uses 18.
#
# Known deviations clang-format cannot express (accepted, low-churn under
# changed-lines enforcement):
#  - the codebase sometimes places `constexpr` on its own line before the
#    declaration; clang-format joins it;
#  - manually broken template-argument lists may be repacked.
Language: Cpp
Standard: c++20
BasedOnStyle: LLVM

# Layout
ColumnLimit: 90
IndentWidth: 2
TabWidth: 2
UseTab: Never
ContinuationIndentWidth: 2
NamespaceIndentation: All
# Access labels are inset by two spaces; their members by four spaces.
# Implicit-access members use two spaces inside the record. dev/format_cpp.py
# removes clang-format's extra level before the first explicit access section.
IndentAccessModifiers: true
MaxEmptyLinesToKeep: 1
KeepEmptyLinesAtTheStartOfBlocks: false

# Braces: Allman everywhere; empty bodies "{}" stay together on their own line.
# A for/if/else body may omit braces only if its whole statement occupies one
# physical line. style_lint.py enforces this; clang-format does not insert braces.
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: true
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterUnion: true
  AfterExternBlock: true
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: false
  BeforeWhile: false
  IndentBraces: false
  SplitEmptyFunction: false
  SplitEmptyRecord: false
  SplitEmptyNamespace: true
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortLambdasOnASingleLine: All
AllowShortBlocksOnASingleLine: Empty
AllowShortEnumsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false

# Classes and constructors
BreakInheritanceList: BeforeColon
BreakConstructorInitializers: BeforeColon
ConstructorInitializerIndentWidth: 2
PackConstructorInitializers: Never
EmptyLineBeforeAccessModifier: Always

# Templates and declarations
AlwaysBreakTemplateDeclarations: Yes
SpaceAfterTemplateKeyword: true
PointerAlignment: Left
ReferenceAlignment: Left
QualifierAlignment: Leave

# Includes: never reorder — include order is load-bearing (ForwardDecls,
# Configure.h) and re-sorting creates churn.
SortIncludes: Never
IncludeBlocks: Preserve
SortUsingDeclarations: false

# Comments and misc
ReflowComments: false
AlignTrailingComments:
  Kind: Leave
SpacesBeforeTrailingComments: 1
FixNamespaceComments: false
AlignAfterOpenBracket: DontAlign
BinPackArguments: true
BinPackParameters: true
AllowAllParametersOfDeclarationOnNextLine: true
AlignOperands: DontAlign
BreakBeforeBinaryOperators: None
BreakBeforeTernaryOperators: true
IndentCaseLabels: true
IndentPPDirectives: None
